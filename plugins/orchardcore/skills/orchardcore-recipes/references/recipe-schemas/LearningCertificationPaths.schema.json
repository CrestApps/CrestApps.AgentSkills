{
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "const": "LearningCertificationPaths",
      "description": "Recipe step discriminator. Must be \u0027LearningCertificationPaths\u0027."
    },
    "Paths": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "itemId": {
            "type": "string",
            "description": "The path id."
          },
          "certificationId": {
            "type": "string",
            "description": "The Skills certification, by id."
          },
          "certificationName": {
            "type": "string",
            "description": "The Skills certification, by name; wins over the id."
          },
          "enabled": {
            "type": "boolean",
            "description": "Whether the path issues certificates."
          },
          "join": {
            "type": [
              "string",
              "integer"
            ],
            "description": "All (0) or Any (1)."
          },
          "initialRequirements": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "description": "The requirement id within the path; generated when omitted."
                },
                "kind": {
                  "type": "string",
                  "description": "CourseCompleted or AssessmentPassed; other modules may add kinds."
                },
                "targetId": {
                  "type": "string",
                  "description": "The content item id of the course or the quiz."
                },
                "minimumGrade": {
                  "type": [
                    "null",
                    "number"
                  ],
                  "minimum": 0,
                  "maximum": 100,
                  "description": "The lowest grade or percent that counts."
                }
              },
              "required": [
                "kind",
                "targetId"
              ]
            },
            "description": "What earns the first certificate."
          },
          "renewalRequirements": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "description": "The requirement id within the path; generated when omitted."
                },
                "kind": {
                  "type": "string",
                  "description": "CourseCompleted or AssessmentPassed; other modules may add kinds."
                },
                "targetId": {
                  "type": "string",
                  "description": "The content item id of the course or the quiz."
                },
                "minimumGrade": {
                  "type": [
                    "null",
                    "number"
                  ],
                  "minimum": 0,
                  "maximum": 100,
                  "description": "The lowest grade or percent that counts."
                }
              },
              "required": [
                "kind",
                "targetId"
              ]
            },
            "description": "What renews it; empty means the first-certificate requirements."
          },
          "referenceDate": {
            "type": [
              "string",
              "integer"
            ],
            "description": "CompletionDate (0), ExpiryDate (1) or FixedDate (2)."
          },
          "fixedMonth": {
            "type": "integer",
            "minimum": 1,
            "maximum": 12,
            "description": "The month of the fixed expiry day."
          },
          "fixedDay": {
            "type": "integer",
            "minimum": 1,
            "maximum": 31,
            "description": "The day of the fixed expiry day."
          },
          "minimumIntervalMonths": {
            "type": "integer",
            "minimum": 0,
            "description": "The shortest first period, for the fixed date rule."
          },
          "renewalWindowDays": {
            "type": "integer",
            "minimum": 0,
            "description": "How many days before expiry renewal opens."
          },
          "gracePeriodDays": {
            "type": "integer",
            "minimum": 0,
            "description": "How many days after expiry a renewal still counts."
          },
          "startsOnFirstRequirement": {
            "type": "boolean",
            "description": "Whether meeting a requirement starts the path."
          },
          "enrollOnRenewal": {
            "type": "boolean",
            "description": "Whether renewal enrolls the holder in the renewal courses."
          }
        }
      },
      "description": "The paths to create, or update by certification."
    }
  },
  "required": [
    "name"
  ],
  "additionalProperties": true
}