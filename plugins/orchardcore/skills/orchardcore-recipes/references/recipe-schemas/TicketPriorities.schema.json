      "description": "Recipe step discriminator. Must be \u0027TicketPriorities\u0027."
    },
    "Priorities": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "ItemId": {
            "type": "string",
            "description": "The ticket priority id; omit it to create one."
