          "Color": {
            "type": [
              "null",
              "string"
            ],
            "description": "The badge color, a CSS color."
          },
          "CreatedUtc": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time",
            "description": "When it was created, in UTC."
          },
          "ModifiedUtc": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time",
            "description": "When it last changed, in UTC."
          },
          "Properties": {
            "type": [
              "null",
              "object"
            ],
            "description": "More values of the ticket priority, by name."
