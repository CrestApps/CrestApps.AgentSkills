{
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "const": "PayrollEmployers",
      "description": "Recipe step discriminator. Must be \u0027PayrollEmployers\u0027."
    },
    "Employers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "ItemId": {
            "type": [
              "null",
              "string"
            ],
            "description": "The employer\u0027s 26-character id; omit it to match by name or create one."
          },
          "Name": {
            "type": [
              "null",
              "string"
            ],
            "description": "The name the employer is known by, unique."
          },
          "LegalName": {
            "type": [
              "null",
              "string"
            ],
            "description": "The legal name printed on statements, checks and forms."
          },
          "TaxId": {
            "type": [
              "null",
              "string"
            ],
            "description": "The employer\u0027s own tax id, such as its employer identification number."
          },
          "Address": {
            "type": [
              "null",
              "object"
            ],
            "description": "The address printed on statements and checks: AddressLine1, AddressLine2, City, Region (the state or province code, such as TX), PostalCode, Country (two letters)."
          },
          "LogoPath": {
            "type": [
              "null",
              "string"
            ],
            "description": "The logo, a path in the media library."
          },
          "CountryPack": {
            "type": [
              "null",
              "string"
            ],
            "description": "The country pack, such as US."
          },
          "Currency": {
            "type": [
              "null",
              "string"
            ],
            "description": "The three-letter currency people are paid in."
          },
          "FundingBankAccountId": {
            "type": [
              "null",
              "string"
            ],
            "description": "The id of the employer\u0027s bank account pay is sent from."
          },
          "SignatoryName": {
            "type": [
              "null",
              "string"
            ],
            "description": "The name printed as the signatory of checks."
          },
          "SignatoryTitle": {
            "type": [
              "null",
              "string"
            ],
            "description": "The signatory\u0027s title."
          },
          "ContactName": {
            "type": [
              "null",
              "string"
            ],
            "description": "The payroll contact\u0027s name."
          },
          "ContactEmail": {
            "type": [
              "null",
              "string"
            ],
            "description": "The payroll contact\u0027s email."
          },
          "ContactPhone": {
            "type": [
              "null",
              "string"
            ],
            "description": "The payroll contact\u0027s phone."
          },
          "Registrations": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "Jurisdiction": {
                  "type": [
                    "null",
                    "string"
                  ],
                  "description": "The jurisdiction, such as US or US-CA."
                },
                "Agency": {
                  "type": [
                    "null",
                    "string"
                  ],
                  "description": "The tax agency."
                },
                "AccountId": {
                  "type": [
                    "null",
                    "string"
                  ],
                  "description": "The employer\u0027s account id with the agency."
                },
                "DepositFrequency": {
                  "type": [
                    "null",
                    "string"
                  ],
                  "description": "How often taxes are deposited, such as Monthly or SemiWeekly."
                },
                "Rates": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "EffectiveFrom": {
                        "type": [
                          "null",
                          "string"
                        ],
                        "description": "The first day of the rate, yyyy-MM-dd."
                      },
                      "Rate": {
                        "type": "number",
                        "description": "The rate, as a percent such as 2.7."
                      }
                    },
                    "required": [
                      "EffectiveFrom",
                      "Rate"
                    ]
                  },
                  "description": "The rates the agency assigned, each from a day on."
                }
              },
              "required": [
                "Jurisdiction"
              ]
            },
            "description": "The employer\u0027s tax registrations."
          },
          "Status": {
            "type": "string",
            "enum": [
              "Active",
              "Inactive"
            ],
            "description": "Whether the employer runs payroll."
          }
        },
        "required": [
          "Name"
        ],
        "additionalProperties": true
      },
      "description": "The employers to create, or update by id or name."
    }
  },
  "required": [
    "name",
    "Employers"
  ],
  "additionalProperties": true
}