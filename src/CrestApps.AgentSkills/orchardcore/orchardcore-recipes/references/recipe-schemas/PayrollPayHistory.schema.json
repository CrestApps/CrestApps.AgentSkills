{
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "const": "PayrollPayHistory",
      "description": "Recipe step discriminator. Must be \u0027PayrollPayHistory\u0027."
    },
    "Statements": {
      "type": "array",
      "description": "Final pay statements paid elsewhere, imported as history into a historical pay run per employer and pay date. Statements already there are skipped.",
      "items": {
        "type": "object",
        "properties": {
          "ItemId": {
            "type": [
              "null",
              "string"
            ],
            "description": "The statement\u0027s id; kept, so the step can run again."
          },
          "Number": {
            "type": [
              "null",
              "string"
            ],
            "description": "The statement\u0027s number; given from the site\u0027s sequence when empty."
          },
          "EmployerId": {
            "type": [
              "null",
              "string"
            ],
            "description": "The employer that paid."
          },
          "StaffMemberId": {
            "type": [
              "null",
              "string"
            ],
            "description": "The staff member paid."
          },
          "EmployeeNumber": {
            "type": [
              "null",
              "string"
            ],
            "description": "The employee number, when the staff member id is not known."
          },
          "PayDate": {
            "type": [
              "null",
              "string"
            ],
            "description": "The pay date, yyyy-MM-dd."
          },
          "PeriodStart": {
            "type": [
              "null",
              "string"
            ],
            "description": "The first day of the period, yyyy-MM-dd."
          },
          "PeriodEnd": {
            "type": [
              "null",
              "string"
            ],
            "description": "The last day of the period, yyyy-MM-dd."
          },
          "Currency": {
            "type": [
              "null",
              "string"
            ],
            "description": "The three-letter currency code."
          },
          "Gross": {
            "type": [
              "null",
              "number"
            ],
            "description": "The gross pay."
          },
          "Net": {
            "type": [
              "null",
              "number"
            ],
            "description": "The net pay."
          },
          "Status": {
            "type": "string",
            "enum": [
              "Final",
              "Paid",
              "Voided"
            ]
          },
          "Lines": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "Type": {
                  "type": "string",
                  "enum": [
                    "Earning",
                    "Deduction",
                    "EmployerContribution",
                    "ImputedIncome",
                    "Reimbursement",
                    "Memo",
                    "Tax"
                  ]
                },
                "PayCodeId": {
                  "type": [
                    "null",
                    "string"
                  ],
                  "description": "The pay code\u0027s id, for a line that is not a tax."
                },
                "TaxCode": {
                  "type": [
                    "null",
                    "string"
                  ],
                  "description": "The tax\u0027s code, for a tax."
                },
                "TaxCategory": {
                  "type": [
                    "null",
                    "string"
                  ],
                  "description": "The tax category, such as IncomeTax."
                },
                "Description": {
                  "type": [
                    "null",
                    "string"
                  ],
                  "description": "What the line is."
                },
                "Jurisdiction": {
                  "type": [
                    "null",
                    "string"
                  ],
                  "description": "The tax\u0027s jurisdiction, such as US."
                },
                "Payer": {
                  "type": "string",
                  "enum": [
                    "Employee",
                    "Employer"
                  ]
                },
                "Hours": {
                  "type": [
                    "null",
                    "number"
                  ],
                  "description": "The hours."
                },
                "Rate": {
                  "type": [
                    "null",
                    "number"
                  ],
                  "description": "The rate."
                },
                "Amount": {
                  "type": [
                    "null",
                    "number"
                  ],
                  "description": "The amount, positive."
                },
                "TaxableWages": {
                  "type": [
                    "null",
                    "number"
                  ],
                  "description": "The wages the tax was worked out on; required on a tax line."
                }
              },
              "required": [
                "Type",
                "Amount"
              ]
            }
          },
          "Payments": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "Snapshot": {
            "type": "object",
            "description": "The names and addresses as printed."
          }
        },
        "required": [
          "EmployerId",
          "PayDate"
        ]
      }
    }
  },
  "required": [
    "name",
    "Statements"
  ]
}