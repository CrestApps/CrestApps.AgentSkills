{
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "const": "TicketDesks",
      "description": "Recipe step discriminator. Must be \u0027TicketDesks\u0027."
    },
    "Desks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "ItemId": {
            "type": "string",
            "description": "The desk id; omit it to create one."
          },
          "Name": {
            "type": "string",
            "minLength": 1,
            "description": "The name."
          },
          "Description": {
            "type": [
              "null",
              "string"
            ],
            "description": "What the desk is for."
          },
          "Audience": {
            "type": "string",
            "enum": [
              "Customers",
              "Internal"
            ],
            "description": "Who the desk serves."
          },
          "DefaultTeamId": {
            "type": [
              "null",
              "string"
            ],
            "description": "The team new tickets go to."
          },
          "HoursScheduleId": {
            "type": [
              "null",
              "string"
            ],
            "description": "The business hours schedule; empty is around the clock."
          },
          "ServiceLevelPolicyId": {
            "type": [
              "null",
              "string"
            ],
            "description": "The service-level policy of its tickets."
          },
          "TicketTypes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "The ticket types it offers; empty offers every type."
          },
          "ReopenWindowDays": {
            "type": "integer",
            "description": "Days after solving in which a requester reply reopens a ticket."
          },
          "AutoCloseDays": {
            "type": "integer",
            "description": "Days a solved ticket waits before it closes; 0 never."
          },
          "DeleteProtectedInformationDays": {
            "type": "integer",
            "description": "Days after a ticket is closed that its protected information is deleted; 0 keeps it."
          },
          "AssignmentStrategy": {
            "type": "string",
            "description": "How a new ticket with a team and no assignee is given to a member: LeastLoaded, RoundRobin, or empty to leave it for an agent."
          },
          "RatingRequestDelayHours": {
            "type": "integer",
            "minimum": 0,
            "description": "Hours after a ticket is solved its requester is asked to rate it, with Tickets Portal on; 0 never asks."
          },
          "AvailabilitySources": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "type": "string"
            },
            "description": "The team availability sources assignment honors on the desk (WorkforceShifts, CalendarAbsences, ContactCenterPresence); omit for the defaults, which leave out Contact Center presence."
          },
          "PriorityMatrix": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "type": "object",
              "properties": {
                "Impact": {
                  "type": "string",
                  "enum": [
                    "Low",
                    "Medium",
                    "High"
                  ],
                  "description": "The impact."
                },
                "Urgency": {
                  "type": "string",
                  "enum": [
                    "Low",
                    "Medium",
                    "High"
                  ],
                  "description": "The urgency."
                },
                "PriorityId": {
                  "type": "string",
                  "description": "The priority a ticket with this impact and urgency gets."
                }
              },
              "required": [
                "Impact",
                "Urgency",
                "PriorityId"
              ]
            },
            "description": "The priority of a ticket for each impact and urgency."
          },
          "NotifyRequester": {
            "type": "boolean",
            "description": "Whether requesters are e-mailed."
          },
          "NotifyAssignee": {
            "type": "boolean",
            "description": "Whether assignees are told."
          },
          "CreatedUtc": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time",
            "description": "When it was created, in UTC."
          },
          "ModifiedUtc": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time",
            "description": "When it last changed, in UTC."
          },
          "Properties": {
            "type": [
              "null",
              "object"
            ],
            "description": "More values of the desk, by name."
          }
        },
        "required": [
          "Name"
        ],
        "additionalProperties": true
      },
      "description": "The desks to create or update by id."
    }
  },
  "required": [
    "name",
    "Desks"
  ],
  "additionalProperties": true
}